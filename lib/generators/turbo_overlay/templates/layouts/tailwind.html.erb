<%= overlay_response_wrapper(:modal) do %>
  <dialog class="turbo-overlay turbo-overlay--modal fixed inset-0 m-auto w-full max-w-lg rounded-lg p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm"
          data-controller="turbo-overlay"
          data-turbo-overlay-id-value="<%= current_overlay_id %>"
          data-turbo-overlay-type-value="modal"
          data-action="cancel->turbo-overlay#cancel click->turbo-overlay#backdropClick"
          aria-labelledby="turbo-modal-title-<%= current_overlay_id %>">
    <div class="flex flex-col bg-white text-gray-900 rounded-lg shadow-xl dark:bg-gray-900 dark:text-gray-100 dark:ring-1 dark:ring-white/10">
      <% if content_for?(:overlay_title) %>
        <header class="flex items-center justify-between px-5 py-4 border-b border-gray-200 dark:border-gray-700">
          <h2 id="turbo-modal-title-<%= current_overlay_id %>" class="text-lg font-semibold text-gray-900 dark:text-gray-100">
            <%= yield(:overlay_title) %>
          </h2>
          <button type="button"
                  class="text-gray-400 hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300 text-2xl leading-none"
                  data-action="turbo-overlay#close"
                  aria-label="Close">&times;</button>
        </header>
      <% end %>

      <div class="px-5 py-4">
        <%= yield %>
      </div>

      <% if content_for?(:overlay_footer) %>
        <footer class="flex items-center justify-end gap-2 px-5 py-4 border-t border-gray-200 dark:border-gray-700">
          <%= yield(:overlay_footer) %>
        </footer>
      <% end %>
    </div>
  </dialog>
<% end %>
