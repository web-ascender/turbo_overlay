<%%= turbo_frame_tag TurboOverlay.configuration.modal.frame_id do %>
  <dialog class="fixed inset-0 m-auto w-full max-w-lg rounded-lg p-0 backdrop:bg-black/50 backdrop:backdrop-blur-sm"
          data-controller="turbo-modal"
          data-action="cancel->turbo-modal#cancel turbo-overlay:close@window->turbo-modal#close"
          aria-labelledby="turbo-modal-title">
    <div class="flex flex-col bg-white rounded-lg shadow-xl">
      <%% if content_for?(:overlay_title) %>
        <header class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
          <h2 id="turbo-modal-title" class="text-lg font-semibold text-gray-900">
            <%%= yield(:overlay_title) %>
          </h2>
          <button type="button"
                  class="text-gray-400 hover:text-gray-600 text-2xl leading-none"
                  data-action="turbo-modal#close"
                  aria-label="Close">&times;</button>
        </header>
      <%% end %>

      <div class="px-5 py-4">
        <%%= yield %>
      </div>

      <%% if content_for?(:overlay_footer) %>
        <footer class="flex items-center justify-end gap-2 px-5 py-4 border-t border-gray-200">
          <%%= yield(:overlay_footer) %>
        </footer>
      <%% end %>
    </div>
  </dialog>
<%% end %>

<style>
  html:has(dialog[data-controller~="turbo-modal"][open]) { overflow: hidden; }
</style>
