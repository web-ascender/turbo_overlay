<%%= turbo_frame_tag TurboOverlay.configuration.modal.frame_id do %>
  <div class="modal"
       tabindex="-1"
       role="dialog"
       data-controller="turbo-modal"
       data-action="turbo-overlay:close@window->turbo-modal#close"
       aria-labelledby="turbo-modal-title">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <%% if content_for?(:overlay_title) %>
          <div class="modal-header">
            <h5 id="turbo-modal-title" class="modal-title">
              <%%= yield(:overlay_title) %>
            </h5>
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"></button>
          </div>
        <%% end %>

        <div class="modal-body">
          <%%= yield %>
        </div>

        <%% if content_for?(:overlay_footer) %>
          <div class="modal-footer">
            <%%= yield(:overlay_footer) %>
          </div>
        <%% end %>
      </div>
    </div>
  </div>
<%% end %>
