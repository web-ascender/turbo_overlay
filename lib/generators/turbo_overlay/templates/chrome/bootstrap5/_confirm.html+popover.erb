<%# Confirm dialog body, wrapped in the popover chrome at template-
    emission time by `overlay_stack_tag`. JS only depends on:
      [data-turbo-overlay-confirm-message] — text insertion point
      [data-turbo-overlay-confirm-cancel]  — cancels (resolves false)
      [data-turbo-overlay-confirm-accept]  — accepts (resolves true)
%>
<p class="mb-2" data-turbo-overlay-confirm-message></p>
<div class="d-flex gap-2">
  <button type="button" class="btn btn-sm btn-secondary flex-fill" data-turbo-overlay-confirm-cancel>Cancel</button>
  <button type="button" class="btn btn-sm btn-primary flex-fill"   data-turbo-overlay-confirm-accept>OK</button>
</div>
