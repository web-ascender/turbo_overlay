<%# Confirm dialog body, wrapped in the popover chrome at template-
    emission time by `overlay_stack_tag`. JS only depends on:
      [data-turbo-overlay-confirm-message] — text insertion point
      [data-turbo-overlay-confirm-cancel]  — cancels (resolves false)
      [data-turbo-overlay-confirm-accept]  — accepts (resolves true)
%>
<p class="text-sm text-gray-900 dark:text-gray-100" data-turbo-overlay-confirm-message></p>
<div class="mt-3 flex items-center justify-end gap-2">
  <button type="button"
          class="px-2 py-1 text-xs rounded border border-gray-300 text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800"
          data-turbo-overlay-confirm-cancel>Cancel</button>
  <button type="button"
          class="px-2 py-1 text-xs rounded bg-blue-600 text-white hover:bg-blue-700"
          data-turbo-overlay-confirm-accept>OK</button>
</div>
