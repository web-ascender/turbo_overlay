<%# Popover-style confirm body, rendered inside the popover partial.
    Edit freely — JS only depends on these data attributes:
      [data-turbo-overlay-confirm-message] — text insertion point
      [data-turbo-overlay-confirm-cancel]  — cancels (resolves false)
      [data-turbo-overlay-confirm-accept]  — accepts (resolves true)
%>
<%= render "turbo_overlay/popover", close_button: false do %>
  <p style="margin:0 0 8px 0;" data-turbo-overlay-confirm-message></p>
  <div style="text-align:right;">
    <button type="button" class="btn btn-xs btn-default" data-turbo-overlay-confirm-cancel>Cancel</button>
    <button type="button" class="btn btn-xs btn-primary" data-turbo-overlay-confirm-accept>OK</button>
  </div>
<% end %>
