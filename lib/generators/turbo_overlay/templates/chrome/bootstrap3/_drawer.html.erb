<% position = current_overlay_position || TurboOverlay.configuration.drawer.position %>
<% backdrop = current_overlay_backdrop? %>
<% close_button = local_assigns.fetch(:close_button) { overlay_close? } %>
<dialog class="turbo-overlay turbo-overlay--drawer turbo-overlay--drawer-<%= position %> turbo-overlay-scaffold<%= " turbo-overlay--no-backdrop" unless backdrop %>"
        data-controller="turbo-overlay"
        data-turbo-overlay-id-value="<%= current_overlay_id %>"
        data-turbo-overlay-type-value="drawer"
        data-turbo-overlay-backdrop-value="<%= backdrop %>"
        data-action="cancel->turbo-overlay#cancel click->turbo-overlay#backdropClick"
        aria-labelledby="turbo-drawer-title-<%= current_overlay_id %>">
  <div class="panel panel-default turbo-drawer-panel" style="position:relative;">
    <% if content_for?(:overlay_title) %>
      <div class="panel-heading">
        <% if close_button %>
          <button type="button"
                  class="close"
                  data-action="turbo-overlay#close"
                  aria-label="Close"><span aria-hidden="true">&times;</span></button>
        <% end %>
        <h4 id="turbo-drawer-title-<%= current_overlay_id %>" class="panel-title">
          <%= yield(:overlay_title) %>
        </h4>
      </div>
    <% elsif close_button %>
      <button type="button"
              class="close"
              style="position:absolute; top:8px; right:12px; z-index:1;"
              data-action="turbo-overlay#close"
              aria-label="Close"><span aria-hidden="true">&times;</span></button>
    <% end %>

    <div class="panel-body turbo-drawer-body">
      <%= yield %>
    </div>

    <% if content_for?(:overlay_footer) %>
      <div class="panel-footer text-right">
        <%= yield(:overlay_footer) %>
      </div>
    <% end %>
  </div>
</dialog>
