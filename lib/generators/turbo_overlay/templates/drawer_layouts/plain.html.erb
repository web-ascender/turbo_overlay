<%% position = TurboOverlay.configuration.drawer.position %>
<%%= overlay_response_wrapper(:drawer) do %>
  <dialog class="turbo-overlay turbo-overlay--drawer turbo-overlay--drawer-<%%= position %> turbo-drawer turbo-drawer--<%%= position %>"
          data-controller="turbo-overlay"
          data-turbo-overlay-id-value="<%%= current_overlay_id %>"
          data-turbo-overlay-type-value="drawer"
          data-action="cancel->turbo-overlay#cancel"
          aria-labelledby="turbo-drawer-title-<%%= current_overlay_id %>">
    <div class="turbo-drawer__content">
      <%% if content_for?(:overlay_title) %>
        <header class="turbo-drawer__header">
          <h2 id="turbo-drawer-title-<%%= current_overlay_id %>" class="turbo-drawer__title">
            <%%= yield(:overlay_title) %>
          </h2>
          <button type="button"
                  class="turbo-drawer__close"
                  data-action="turbo-overlay#close"
                  aria-label="Close">&times;</button>
        </header>
      <%% end %>

      <div class="turbo-drawer__body">
        <%%= yield %>
      </div>

      <%% if content_for?(:overlay_footer) %>
        <footer class="turbo-drawer__footer">
          <%%= yield(:overlay_footer) %>
        </footer>
      <%% end %>
    </div>
  </dialog>
<%% end %>

<style>
  dialog.turbo-drawer {
    border: 0; padding: 0; margin: 0;
    background: white;
    box-shadow: 0 0 30px rgba(0, 0, 0, 0.15);
    max-width: 100vw; max-height: 100vh;
  }
  dialog.turbo-drawer::backdrop { background: rgba(0, 0, 0, 0.5); }

  dialog.turbo-drawer--right { inset: 0 0 0 auto; height: 100vh; width: 24rem; }
  dialog.turbo-drawer--left  { inset: 0 auto 0 0; height: 100vh; width: 24rem; }
  dialog.turbo-drawer--top   { inset: 0 0 auto 0; width: 100vw; max-height: 50vh; }
  dialog.turbo-drawer--bottom { inset: auto 0 0 0; width: 100vw; max-height: 50vh; }

  .turbo-drawer__content { display: flex; flex-direction: column; height: 100%; }
  .turbo-drawer__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 1.25rem; border-bottom: 1px solid #e5e7eb;
  }
  .turbo-drawer__title { margin: 0; font-size: 1.125rem; font-weight: 600; }
  .turbo-drawer__close {
    background: none; border: 0; font-size: 1.5rem; cursor: pointer; line-height: 1;
  }
  .turbo-drawer__body { padding: 1.25rem; flex: 1; overflow-y: auto; }
  .turbo-drawer__footer {
    padding: 1rem 1.25rem; border-top: 1px solid #e5e7eb;
    display: flex; justify-content: flex-end; gap: 0.5rem;
  }

  dialog.turbo-drawer--right[open]   { animation: turbo-overlay-slide-in-right 0.3s ease-out; }
  dialog.turbo-drawer--left[open]    { animation: turbo-overlay-slide-in-left 0.3s ease-out; }
  dialog.turbo-drawer--top[open]     { animation: turbo-overlay-slide-in-top 0.3s ease-out; }
  dialog.turbo-drawer--bottom[open]  { animation: turbo-overlay-slide-in-bottom 0.3s ease-out; }
  dialog.turbo-drawer[open]::backdrop { animation: turbo-overlay-backdrop-in 0.3s ease-out; }

  dialog.turbo-drawer--right.turbo-overlay-closing  { animation: turbo-overlay-slide-out-right 0.3s ease-out forwards; }
  dialog.turbo-drawer--left.turbo-overlay-closing   { animation: turbo-overlay-slide-out-left 0.3s ease-out forwards; }
  dialog.turbo-drawer--top.turbo-overlay-closing    { animation: turbo-overlay-slide-out-top 0.3s ease-out forwards; }
  dialog.turbo-drawer--bottom.turbo-overlay-closing { animation: turbo-overlay-slide-out-bottom 0.3s ease-out forwards; }
  dialog.turbo-drawer.turbo-overlay-closing::backdrop { animation: turbo-overlay-backdrop-out 0.3s ease-out forwards; }

  @keyframes turbo-overlay-slide-in-right  { from { transform: translateX(100%); }  to { transform: translateX(0); } }
  @keyframes turbo-overlay-slide-in-left   { from { transform: translateX(-100%); } to { transform: translateX(0); } }
  @keyframes turbo-overlay-slide-in-top    { from { transform: translateY(-100%); } to { transform: translateY(0); } }
  @keyframes turbo-overlay-slide-in-bottom { from { transform: translateY(100%); }  to { transform: translateY(0); } }
  @keyframes turbo-overlay-slide-out-right  { from { transform: translateX(0); } to { transform: translateX(100%); } }
  @keyframes turbo-overlay-slide-out-left   { from { transform: translateX(0); } to { transform: translateX(-100%); } }
  @keyframes turbo-overlay-slide-out-top    { from { transform: translateY(0); } to { transform: translateY(-100%); } }
  @keyframes turbo-overlay-slide-out-bottom { from { transform: translateY(0); } to { transform: translateY(100%); } }
  @keyframes turbo-overlay-backdrop-in   { from { background: rgba(0,0,0,0); }   to { background: rgba(0,0,0,0.5); } }
  @keyframes turbo-overlay-backdrop-out  { from { background: rgba(0,0,0,0.5); } to { background: rgba(0,0,0,0); } }

  @media (prefers-reduced-motion: reduce) {
    dialog.turbo-drawer[open],
    dialog.turbo-drawer.turbo-overlay-closing,
    dialog.turbo-drawer[open]::backdrop,
    dialog.turbo-drawer.turbo-overlay-closing::backdrop { animation: none; }
  }

  html:has(dialog.turbo-drawer[open]) { overflow: hidden; }
</style>
