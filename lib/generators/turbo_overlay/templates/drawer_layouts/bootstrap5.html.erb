<%% offcanvas_class = {
  right:  "offcanvas-end",
  left:   "offcanvas-start",
  top:    "offcanvas-top",
  bottom: "offcanvas-bottom"
}.fetch(TurboOverlay.configuration.drawer.position) %>
<%%= overlay_response_wrapper(:drawer) do %>
  <div class="offcanvas <%%= offcanvas_class %>"
       tabindex="-1"
       data-controller="turbo-overlay"
       data-turbo-overlay-id-value="<%%= current_overlay_id %>"
       data-turbo-overlay-type-value="drawer"
       aria-labelledby="turbo-drawer-title-<%%= current_overlay_id %>">
    <%% if content_for?(:overlay_title) %>
      <div class="offcanvas-header">
        <h5 id="turbo-drawer-title-<%%= current_overlay_id %>" class="offcanvas-title">
          <%%= yield(:overlay_title) %>
        </h5>
        <button type="button"
                class="btn-close"
                data-action="turbo-overlay#close"
                aria-label="Close"></button>
      </div>
    <%% end %>

    <div class="offcanvas-body">
      <%%= yield %>
    </div>

    <%% if content_for?(:overlay_footer) %>
      <div class="offcanvas-footer p-3 border-top d-flex justify-content-end gap-2">
        <%%= yield(:overlay_footer) %>
      </div>
    <%% end %>
  </div>
<%% end %>
