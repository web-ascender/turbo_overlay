<%% position = TurboOverlay.configuration.drawer.position %>
<%% position_classes = {
  right:  "inset-y-0 right-0 left-auto h-screen w-96 max-w-full",
  left:   "inset-y-0 left-0 right-auto h-screen w-96 max-w-full",
  top:    "inset-x-0 top-0 bottom-auto w-screen max-h-[50vh]",
  bottom: "inset-x-0 bottom-0 top-auto w-screen max-h-[50vh]"
}.fetch(position) %>
<%%= turbo_frame_tag TurboOverlay.configuration.drawer.frame_id do %>
  <dialog class="fixed m-0 p-0 bg-white shadow-2xl backdrop:bg-black/50 <%%= position_classes %>"
          data-controller="turbo-drawer"
          data-action="cancel->turbo-drawer#cancel turbo-overlay:close@window->turbo-drawer#close"
          aria-labelledby="turbo-drawer-title">
    <div class="flex flex-col h-full">
      <%% if content_for?(:overlay_title) %>
        <header class="flex items-center justify-between px-5 py-4 border-b border-gray-200">
          <h2 id="turbo-drawer-title" class="text-lg font-semibold text-gray-900">
            <%%= yield(:overlay_title) %>
          </h2>
          <button type="button"
                  class="text-gray-400 hover:text-gray-600 text-2xl leading-none"
                  data-action="turbo-drawer#close"
                  aria-label="Close">&times;</button>
        </header>
      <%% end %>

      <div class="flex-1 overflow-y-auto px-5 py-4">
        <%%= yield %>
      </div>

      <%% if content_for?(:overlay_footer) %>
        <footer class="flex items-center justify-end gap-2 px-5 py-4 border-t border-gray-200">
          <%%= yield(:overlay_footer) %>
        </footer>
      <%% end %>
    </div>
  </dialog>
<%% end %>

<style>
  html:has(dialog[data-controller~="turbo-drawer"][open]) { overflow: hidden; }
</style>
