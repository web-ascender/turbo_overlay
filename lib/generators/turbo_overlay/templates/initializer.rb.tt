TurboOverlay.configure do |config|
  config.modal do |m|
    # The id of the turbo-frame that wraps the modal on the host page.
    # Links targeted at this frame open inside the modal.
    # m.frame_id = "turbo_modal"

    # Rails request variant assigned to modal requests. Lets you ship
    # `show.html+modal.erb` next to `show.html.erb`.
    # m.variant = :modal

    # Layout used to render modal responses.
    # m.layout_name = "turbo_modal"

    # Stimulus identifier the modal layout binds to.
    # m.stimulus_identifier = "turbo-modal"
  end

  config.drawer do |d|
    # Same as modal, plus a position for the shipped layouts:
    # :left, :right (default), :top, :bottom.
    # d.frame_id = "turbo_drawer"
    # d.variant  = :drawer
    # d.layout_name = "turbo_drawer"
    # d.stimulus_identifier = "turbo-drawer"
    # d.position = :right
  end
end
