<h1>Widgets</h1>

<%# Drives the smooth same-page redirect system tests. The counter
    increments on every `widgets#bump` POST; that action redirects
    back to this index. The morph-behind path should refresh this
    element in place behind the still-open overlay. %>
<div data-test-bump-counter><%= @bump_counter || 0 %></div>

<ul>
  <% @widgets.each do |id, w| %>
    <li>
      <%= w[:name] %>
      <%= modal_link_to   "Modal",       widget_path(id), id: "modal-link-#{id}" %>
      <%= drawer_link_to  "Drawer",      widget_path(id), id: "drawer-link-#{id}" %>
      <%= popover_link_to "Popover",     widget_path(id), id: "popover-link-#{id}" %>
      <%# hint_link_to is a plain link decorated with hint data attrs;
          the +hint variant template is what actually renders the body. %>
      <%= hint_link_to    "Hint #{w[:name]}", widget_path(id) %>
    </li>
  <% end %>
</ul>

<%# Modal that suppresses the chrome's default × button via close: false. %>
<%= modal_link_to  "Modal without close", widget_path("1"),
                   close: false, id: "modal-without-close" %>

<%# Drives the form re-render test. %>
<%= modal_link_to  "New widget", new_widget_path, id: "modal-new-widget" %>

<%# Drives URL-advance system tests. advance: true pushes the link's
    href; advance: "/custom" pushes a custom URL; advance: false opts
    out (the absence of any default flips this back to no-op anyway). %>
<%= modal_link_to  "Modal advance",        widget_path("1"),
                   advance: true,           id: "modal-advance" %>
<%= modal_link_to  "Modal advance custom", widget_path("1"),
                   advance: "/widgets/1/custom", id: "modal-advance-custom" %>
<%= drawer_link_to "Drawer advance",       widget_path("1"),
                   advance: true,           id: "drawer-advance" %>

<%# Drives the popover form re-render test — asserts the popover stays
    anchored to its trigger across validation-failure morph. %>
<%= popover_link_to "New widget popover", new_widget_path,
                    id: "popover-new-widget" %>

<%# Drives the themed-confirm test. button_to wraps in a form so Turbo
    routes the click through Turbo.config.forms.confirm. %>
<%= button_to "Delete Sprocket",
              widget_path("1"),
              method: :delete,
              data: { turbo_confirm: "Are you sure you want to delete Sprocket?" } %>

<%# Drives the smooth same-page redirect (morph-behind) system tests.
    Distinct text from "Modal" so the existing `click_on "Modal"` tests
    aren't shadowed by these triggers. %>
<%= modal_link_to "Bump counter",         bump_form_widgets_path, id: "modal-bump" %>
<%= modal_link_to "Bump counter advance", bump_form_widgets_path,
                  advance: true, id: "modal-bump-advance" %>

<%# Drives the *_button_to non-GET overlay-open system tests. POSTs
    to `widgets#preview`, which renders show.html.erb. The submit
    hook in setup.js reads the form's data-turbo-overlay-* attrs and
    adds the request headers, the controller concern wraps the
    response in the overlay layout — same end state as a click on
    `modal_link_to`, just from a non-GET trigger. %>
<%= modal_button_to   "Modal button",   preview_widget_path("1"), id: "modal-button-1" %>
<%= drawer_button_to  "Drawer button",  preview_widget_path("1"), id: "drawer-button-1" %>
<%= popover_button_to "Popover button", preview_widget_path("1"), id: "popover-button-1" %>

<%# Drives the TurboOverlay.visit (programmatic open) system tests.
    Non-anchor triggers — buttons whose click handlers call the JS
    API. Exercises the `window.TurboOverlay` global path. %>
<button id="js-visit-modal"
        onclick="TurboOverlay.visit('<%= widget_path("1") %>')">
  Open Sprocket via JS
</button>
<button id="js-visit-popover"
        onclick="TurboOverlay.visit('<%= widget_path("1") %>', { type: 'popover', anchor: this })">
  Open Sprocket popover via JS
</button>

<%# Drives popover scroll-reposition tests. The spacer pushes the
    bottom trigger past the initial viewport so we can open a popover,
    scroll the window, and assert the popover tracked the anchor. %>
<div style="height: 2000px"></div>
<%= popover_link_to "Popover near page bottom", widget_path("1"),
                    id: "popover-bottom" %>
<%= popover_link_to "Popover-right near page bottom", widget_path("1"),
                    position: :right, id: "popover-right-bottom" %>
<%= popover_link_to "Popover-left near page bottom", widget_path("1"),
                    position: :left, id: "popover-left-bottom" %>
<div style="height: 2000px"></div>
