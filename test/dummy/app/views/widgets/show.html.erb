<% overlay_title @widget[:name] %>

<div data-test-widget-show="<%= @widget[:name] %>">
  <p><%= @widget[:description] %></p>

  <%# Stacking: clicking this from inside the Sprocket modal opens a
      second modal on top, exercising the stack registry. %>
  <% if @widget[:name] == "Sprocket" %>
    <%= modal_link_to "Open Flywheel", widget_path("2") %>
    <%= popover_link_to "Popover from modal", widget_path("2") %>
    <%= popover_link_to "Right popover", widget_path("2"),
                        position: :right, id: "popover-right-from-drawer" %>
    <%= drawer_link_to "Drawer non-modal", widget_path("2"),
                       position: :right, backdrop: false,
                       id: "drawer-non-modal-from-drawer" %>

    <%# Drives stacked URL-advance tests: opening this from inside an
        advance modal should push a second history entry; two back
        presses close them in reverse order. %>
    <%= modal_link_to "Open Flywheel advance", widget_path("2"),
                      advance: true, id: "modal-advance-inner" %>
  <% end %>

  <%# Server-initiated close: POST returns a turbo_stream that closes
      this overlay by id. %>
  <%= button_to "Save and close",
                close_widget_path(params[:id]),
                method: :post,
                form: { data: { turbo_stream: true } } %>
</div>
